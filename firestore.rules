rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fonction helper pour vérifier si un utilisateur est admin
    function isAdmin(uid) {
      return uid != null &&
             exists(/databases/$(database)/documents/users/$(uid)) &&
             get(/databases/$(database)/documents/users/$(uid)).data.role == "admin";
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminUser() {
      return isSignedIn() && isAdmin(request.auth.uid);
    }

    // Vrai si la mise à jour ne touche que les champs listés
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Avis valide : note de 1 à 5, message de taille raisonnable
    function isValidReview(data) {
      return data.rating is number && data.rating >= 1 && data.rating <= 5
             && data.get('message', '') is string && data.get('message', '').size() <= 2000;
    }

    // Les compteurs d'une recette ne sont écrits que par les Cloud Functions
    function hasNoCounters(data) {
      return !data.keys().hasAny(['likesCount', 'ratingCount', 'ratingAverage']);
    }

    // === Utilisateurs ===
    // Données privées (email, rôle, listes…) : propriétaire et admins uniquement.
    // La partie publique (pseudo, avatar) est dans /publicProfiles.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdminUser());

      // Création de son propre profil, sans pouvoir s'attribuer un rôle autre que "user"
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.get('role', 'user') == 'user';

      // Mise à jour de son propre profil sans toucher au rôle ; l'admin peut tout modifier
      allow update: if isAdminUser()
                    || (isSignedIn() && request.auth.uid == userId
                        && request.resource.data.get('role', 'user') == resource.data.get('role', 'user'));

      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdminUser());
    }

    // === Profils publics ===
    // Copie de la partie publique de /users, écrite uniquement par la Cloud Function syncPublicProfile.
    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // === Likes (nouvelle collection) ===
    match /likes/{likeId} {
      // Permettre la lecture à tous les utilisateurs authentifiés
      allow read: if true;

      // Permettre la création uniquement si:
      // - L'utilisateur est authentifié
      // - L'ID du document suit le format userId_recetteId
      // - Le userId dans le document correspond à l'utilisateur authentifié
      // - Le document contient tous les champs requis
      allow create: if request.auth != null
                    && likeId == request.auth.uid + '_' + request.resource.data.recetteId
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'userName', 'recetteId', 'createdAt']);

      // Permettre la suppression uniquement si l'utilisateur est le propriétaire du like
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;

      // Interdire les mises à jour (un like ne doit pas être modifié, seulement créé ou supprimé)
      allow update: if false;
    }

    // === Recettes ===
    match /recipes/{recipeId} {
      // Lecture publique
      allow read: if true;

      // Création réservée aux admins (validation d'une demande dans /recipesRequest).
      // L'import TikTok passe par Firebase Admin côté serveur et n'est pas concerné.
      allow create: if isAdminUser();

      // Mise à jour par l'auteur ou un admin, sans toucher aux compteurs
      // (likesCount, ratingCount, ratingAverage : maintenus par les Cloud Functions)
      allow update: if isSignedIn()
                    && (request.auth.uid == resource.data.createdBy || isAdminUser())
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['likesCount', 'ratingCount', 'ratingAverage']);

      allow delete: if isSignedIn() &&
                    (request.auth.uid == resource.data.createdBy || isAdminUser());
    }

    // === Posts ===
    match /posts/{postId} {
      // Lecture publique
      allow read: if true;

      // Création par un utilisateur connecté, en son nom (ou par un admin)
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdminUser());

      // L'auteur ou un admin peut tout modifier ; les autres ne peuvent que liker / déliker
      allow update: if isSignedIn() && (
                      request.auth.uid == resource.data.userId
                      || isAdminUser()
                      || onlyChanges(['likes'])
                    );

      // Suppression par l'auteur ou un admin
      allow delete: if isSignedIn() &&
                    (request.auth.uid == resource.data.userId || isAdminUser());
    }

    // === Reviews (commentaires/avis) ===
    match /reviews/{reviewId} {
      // Lecture publique
      allow read: if true;

      // Création par un utilisateur connecté, en son nom. L'id du document est
      // {userId}_{recipeId} : un seul avis par personne et par recette.
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.recipeId is string
                    && reviewId == request.auth.uid + '_' + request.resource.data.recipeId
                    && isValidReview(request.resource.data);

      // Modification par l'auteur (même contrôle qu'à la création, sans changer d'auteur
      // ni de recette) ou par un admin
      allow update: if isAdminUser()
                    || (isSignedIn() && request.auth.uid == resource.data.userId
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.recipeId == resource.data.recipeId
                        && isValidReview(request.resource.data));

      // Suppression par l'auteur ou un admin
      allow delete: if isSignedIn() &&
                    (request.auth.uid == resource.data.userId || isAdminUser());
    }

    // === Ingredients ===
    match /ingredients/{ingredientId} {
      // Lecture publique
      allow read: if true;

      // Tout utilisateur connecté peut proposer un ingrédient depuis le formulaire de recette
      allow create: if isSignedIn();

      // Le créateur renseigne le champ ingredientId juste après la création ; le reste est réservé aux admins
      allow update: if isAdminUser()
                    || (isSignedIn() && onlyChanges(['ingredientId']) && request.resource.data.ingredientId == ingredientId);
      allow delete: if isAdminUser();
    }

    // === Units (unités de mesure) ===
    match /units/{unitId} {
      // Lecture publique
      allow read: if true;

      // Tout utilisateur connecté peut créer une unité manquante (champs contrôlés)
      allow create: if isAdminUser() || (
        isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.get('abbreviation', '') is string
        && request.resource.data.get('abbreviation', '').size() <= 10
        && request.resource.data.type in ['mass', 'volume', 'count', 'other']
        && (!('toBase' in request.resource.data)
            || (request.resource.data.toBase is number && request.resource.data.toBase > 0))
        && request.resource.data.get('createdBy', request.auth.uid) == request.auth.uid
      );

      // Modification / suppression : admins uniquement
      allow update, delete: if isAdminUser();
    }

    // === Abonnés newsletter ===
    // Inscriptions et désinscriptions passent par le serveur (Firebase Admin) :
    // aucun accès client hormis la consultation / suppression par un admin.
    match /abonnes/{docId} {
      allow read, delete: if isAdminUser();
    }

    // === Consentement cookies ===
    match /cookieConsent/{docId} {
      // Permet à n'importe qui d'enregistrer son consentement
      allow create: if true;

      // Lecture uniquement pour les admins
      allow read: if isAdminUser();
    }

    // === Recette de la semaine ===
    match /weeklyRecipe/{current} {
      // Lecture publique
      allow read: if true;

      // Écriture uniquement pour les admins
      allow write: if isAdminUser();
    }

    // === Demandes de recettes ===
    match /recipesRequest/{docId} {
      // Lecture par l'auteur de la demande ou un admin ; suppression par un admin
      allow read: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdminUser());
      allow delete: if isAdminUser();

      // Création en son propre nom, sans compteurs
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && hasNoCounters(request.resource.data);

      // Mise à jour par l'auteur (sans changer d'auteur ni ajouter de compteurs) ou par un admin
      allow update: if isAdminUser()
                    || (isSignedIn() && resource.data.createdBy == request.auth.uid
                        && request.resource.data.createdBy == request.auth.uid
                        && hasNoCounters(request.resource.data));
    }

    // === Listes de course ===
    match /shoppingLists/{shoppingListId} {
      // Lecture uniquement par le propriétaire
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;

      // Création uniquement pour les utilisateurs authentifiés
      // Vérifier que le userId correspond à l'utilisateur authentifié
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'items', 'createdAt', 'updatedAt']);

      // Mise à jour uniquement par le propriétaire
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId;

      // Suppression uniquement par le propriétaire
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
    }

    // === Bloquer tout accès par défaut aux autres collections ===
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
